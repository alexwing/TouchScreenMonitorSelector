{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TouchScreen Monitor Selector",
  "version": "1.0.0",
  "identifier": "com.alexwing.touchscreenmonitorselector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TouchScreen Monitor Selector",
        "label": "main",
        "width": 520,
        "height": 640,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
